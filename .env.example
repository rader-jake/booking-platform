# Local dev: `npm run test:db` starts Postgres on 54329 (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/booking_dev
PORT=3000
LOG_LEVEL=info

# "google" in production. "fake" uses an in-memory calendar (local dev / demos).
CALENDAR_PROVIDER=fake
# base64 of the service-account JSON:  base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
