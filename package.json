{
  "name": "booking-platform",
  "version": "0.1.0",
  "description": "Multi-tenant booking API (Google Calendar-backed)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/db/migrate.js && node dist/src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:db": "docker compose up -d --wait",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "googleapis": "^183.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
